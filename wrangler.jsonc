{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "phuket-santa",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "BOOKINGS",
      "database_name": "phuket-santa-bookings",
      "database_id": "1e529783-36d6-4a1b-8694-6f60235894e0",
    },
  ],
  "triggers": { "crons": ["* * * * *"] },
}
